#!/usr/bin/env bash
# Ключ, попавший в коммит, считается утёкшим: репозиторий публикуется рядом (skill), а история
# правится только переписыванием. Поэтому проверка стоит здесь, до коммита (спека pilot-deploy).
#
# Включается один раз: ./scripts/install-hooks.sh
set -euo pipefail

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "gitleaks не установлен — секреты в коммите никто не проверит." >&2
  echo "Поставить: brew install gitleaks   (обойти один раз: git commit --no-verify)" >&2
  exit 1
fi

stop() {
  echo >&2
  echo "Коммит остановлен: похоже на секрет. Значение убрать, ключ считать скомпрометированным." >&2
  echo "Секреты на сервере задаются через deploy/bin/set-secret (значение в .env на сервере, не в репозитории)." >&2
  exit 1
}

# Первый проход — по самому коммиту: ловит однострочное (токены, пароли в строке, ключи API).
# `--redact` не печатает найденное значение в терминал.
gitleaks git --staged --no-banner --redact . || stop

# Второй проход — по содержимому файлов целиком. Он нужен, потому что первый смотрит на diff, где
# каждая строка идёт со своим «+», и многострочное совпадение (приватный ключ: BEGIN, тело, END)
# на такой разметке не срабатывает. Проверено: ключ RSA первый проход пропускает, второй ловит.
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
git checkout-index --all --force --prefix="$tmp/"
gitleaks dir "$tmp" --no-banner --redact || stop
