#!/usr/bin/env bash
# deploy/bin/set-secret — секреты только в .env на сервере, значение не
# печатается никуда: ни в stdout, ни в stderr, даже в текстах ошибок.
#
# Использование:
#   set-secret NAME              — читает значение скрытым вводом (read -rs), пишет/заменяет строку в .env
#   set-secret --generate NAME   — генерирует 32 байта (64 hex-символа) через openssl, пишет строку
#   set-secret --init-db         — заводит POSTGRES_PASSWORD/APP_DB_PASSWORD/SYSTEM_DB_PASSWORD и три
#                                   DATABASE_*_URL, не трогая то, что уже задано
#   set-secret --list            — печатает только имена заданных (непустых) переменных
#
# Путь к .env переопределяется TASKANO_ENV_FILE (используется тестом).
set -euo pipefail
export LC_ALL=C

ENV_FILE="${TASKANO_ENV_FILE:-/opt/taskano/.env}"
NAME_RE='^[A-Z][A-Z0-9_]*$'

usage() {
  echo "Использование: set-secret NAME | set-secret --generate NAME | set-secret --init-db | set-secret --list" >&2
}

# Файл должен существовать с правами 600 ДО первой записи — секрет не должен ни секунды
# полежать в файле с обычными правами.
ensure_file() {
  if [[ ! -f "$ENV_FILE" ]]; then
    mkdir -p "$(dirname "$ENV_FILE")"
    : > "$ENV_FILE"
  fi
  chmod 600 "$ENV_FILE"
}

# Текущее значение переменной NAME, если оно задано (непусто). Пусто — переменной нет либо
# она пустая — оба случая трактуем как «не задано».
current_value() {
  local name="$1"
  ensure_file
  grep -E "^${name}=" "$ENV_FILE" 2>/dev/null | tail -n1 | cut -d= -f2- || true
}

is_set() {
  local v
  v="$(current_value "$1")"
  [[ -n "$v" ]]
}

# Пишет/заменяет строку NAME=VALUE, не выводя значение никуда.
write_var() {
  local name="$1" value="$2"
  ensure_file
  local tmp
  tmp="$(mktemp "$(dirname "$ENV_FILE")/.env.XXXXXX")"
  if grep -qE "^${name}=" "$ENV_FILE"; then
    # grep -v выходит с кодом 1, если после фильтра не осталось ни строки (например,
    # единственная строка файла — как раз заменяемая переменная) — под `set -e` это
    # молча оборвало бы запись, поэтому код возврата здесь не проверяем.
    grep -vE "^${name}=" "$ENV_FILE" > "$tmp" || true
  else
    cat "$ENV_FILE" > "$tmp"
  fi
  printf '%s=%s\n' "$name" "$value" >> "$tmp"
  mv "$tmp" "$ENV_FILE"
  chmod 600 "$ENV_FILE"
}

validate_name() {
  local name="$1"
  if [[ ! "$name" =~ $NAME_RE ]]; then
    echo "Недопустимое имя переменной (ожидается ^[A-Z][A-Z0-9_]*\$)" >&2
    exit 1
  fi
}

cmd_list() {
  ensure_file
  grep -E '^[A-Z][A-Z0-9_]*=.+' "$ENV_FILE" | cut -d= -f1 | sort -u || true
}

cmd_generate() {
  local name="$1"
  validate_name "$name"
  write_var "$name" "$(openssl rand -hex 32)"
  echo "Записано: $name"
}

cmd_prompt() {
  local name="$1"
  validate_name "$name"
  local value
  read -rs -p "Значение для $name (ввод скрыт): " value
  echo >&2
  if [[ -z "$value" ]]; then
    echo "Пустое значение отклонено" >&2
    exit 1
  fi
  write_var "$name" "$value"
  echo "Записано: $name"
}

cmd_init_db() {
  ensure_file
  local written=()
  local name
  for name in POSTGRES_PASSWORD APP_DB_PASSWORD SYSTEM_DB_PASSWORD; do
    if ! is_set "$name"; then
      write_var "$name" "$(openssl rand -hex 32)"
      written+=("$name")
    fi
  done

  local owner_pass app_pass system_pass
  owner_pass="$(current_value POSTGRES_PASSWORD)"
  app_pass="$(current_value APP_DB_PASSWORD)"
  system_pass="$(current_value SYSTEM_DB_PASSWORD)"

  if ! is_set DATABASE_URL; then
    write_var DATABASE_URL "postgres://taskano_owner:${owner_pass}@db:5432/taskano"
    written+=(DATABASE_URL)
  fi
  if ! is_set DATABASE_APP_URL; then
    write_var DATABASE_APP_URL "postgres://taskano_app:${app_pass}@db:5432/taskano"
    written+=(DATABASE_APP_URL)
  fi
  if ! is_set DATABASE_SYSTEM_URL; then
    write_var DATABASE_SYSTEM_URL "postgres://taskano_system:${system_pass}@db:5432/taskano"
    written+=(DATABASE_SYSTEM_URL)
  fi

  if [[ ${#written[@]} -eq 0 ]]; then
    echo "Уже задано, ничего не изменено"
  else
    echo "Записано: ${written[*]}"
  fi
}

main() {
  local arg="${1:-}"
  case "$arg" in
    --list)
      [[ $# -eq 1 ]] || { usage; exit 1; }
      cmd_list
      ;;
    --generate)
      [[ $# -eq 2 ]] || { echo "Использование: set-secret --generate NAME" >&2; exit 1; }
      cmd_generate "$2"
      ;;
    --init-db)
      [[ $# -eq 1 ]] || { usage; exit 1; }
      cmd_init_db
      ;;
    -h|--help)
      usage
      ;;
    "")
      usage
      exit 1
      ;;
    *)
      [[ $# -eq 1 ]] || { echo "Использование: set-secret NAME" >&2; exit 1; }
      cmd_prompt "$arg"
      ;;
  esac
}

main "$@"
