{
  "name": "taskano",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/src/main.js",
    "build": "tsc -p tsconfig.build.json && npm run build:app",
    "build:app": "vite build --config app/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p app/tsconfig.json --noEmit",
    "test": "vitest run",
    "migrate": "tsx src/db/migrate.ts",
    "admin": "tsx src/admin/cli.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "franc-min": "^6.2.0",
    "grammy": "^1.46.0",
    "graphile-worker": "^0.17.3",
    "jose": "^6.2.12",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "resend": "^6.28.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.3",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "preact": "^10.29.8",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "5.9",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
