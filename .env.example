# Имена переменных. Значения — только в /opt/taskano/.env на сервере (bin/set-secret) или в .env.local для разработки.
PUBLIC_URL=
DATABASE_URL=
DATABASE_APP_URL=
DATABASE_SYSTEM_URL=
POSTGRES_PASSWORD=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_TEST_BOT_TOKEN=
OWNER_TELEGRAM_CHAT_ID=
ANTHROPIC_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=
ENCRYPTION_KEY=
HMAC_SECRET=
TASKANO_VERSION=
LOG_LEVEL=
MEDIA_DIR=
GROUP_MODEL=
# Демо-вход для ревьюера каталога (спека demo-access). В .env — только sha256 кода, не сам код.
DEMO_LOGIN_EMAIL=
DEMO_LOGIN_CODE_SHA256=
# Вход через Google на странице подключения к Claude (спека google-login). Пусто — кнопки нет.
# Redirect URI в Google Cloud Console: <PUBLIC_URL>/oauth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Подтверждение домена в каталоге ChatGPT: токен из кабинета OpenAI (отдаётся на /.well-known/openai-apps-challenge)
OPENAI_APPS_CHALLENGE=
# Открытая регистрация (спека open-signup): сколько компаний без инвайт-кода в сутки на весь продукт.
SIGNUP_ORGS_PER_DAY=50
